{
  "metrics": [
    {
      "name": "k8s.pod.cpu.usage",
      "unit": "percent_of_node",
      "stat": "Average",
      "pod_thresholds": [
        {
          "pod_filter": "daemonset",
          "threshold": 3.0,
          "description": "DaemonSet agent pod CPU ceiling as percent of node allocatable CPU"
        },
        {
          "pod_filter": "scraper",
          "threshold": 2.0,
          "description": "Cluster scraper pod CPU ceiling as percent of node allocatable CPU"
        }
      ]
    },
    {
      "name": "k8s.pod.memory.working_set",
      "unit": "percent_of_node",
      "stat": "Average",
      "pod_thresholds": [
        {
          "pod_filter": "daemonset",
          "threshold": 5.5,
          "description": "DaemonSet agent pod memory ceiling as percent of node allocatable memory"
        },
        {
          "pod_filter": "scraper",
          "threshold": 6.0,
          "description": "Cluster scraper pod memory ceiling as percent of node allocatable memory"
        }
      ]
    }
  ],
  "node_allocatable_queries": {
    "cpu": "kube_node_status_allocatable",
    "memory": "kube_node_status_allocatable"
  }
}
