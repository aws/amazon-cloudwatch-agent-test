{
  "agent": {
    "run_as_user": "root",
    "debug": true
  },
  "logs": {
    "logs_collected": {
      "syslog": {
        "listeners": [
          {
            "listen_address": "udp://127.0.0.1:1514",
            "protocol": "rfc5424"
          }
        ],
        "log_group_name": "{log_group}",
        "log_stream_name": "udp-stream"
      }
    }
  }
}
