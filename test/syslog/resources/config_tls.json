{
  "agent": {
    "run_as_user": "root",
    "debug": true
  },
  "logs": {
    "logs_collected": {
      "syslog": {
        "listeners": [
          {
            "listen_address": "tcp://127.0.0.1:6514",
            "protocol": "rfc5424",
            "tls": {
              "cert_file": "/opt/aws/amazon-cloudwatch-agent/etc/tls/server.pem",
              "key_file": "/opt/aws/amazon-cloudwatch-agent/etc/tls/server-key.pem",
              "min_version": "1.2"
            }
          }
        ],
        "log_group_name": "{log_group}",
        "log_stream_name": "tls-stream"
      }
    }
  }
}
