{
  "opentelemetry": {
    "cluster_name": "AKS_CLUSTER_NAME",
    "collect": {
      "container_insights": {
        "collection_interval": 30,
        "role": "cluster",
        "solutions": {
          "keda": {
            "enabled": true,
            "namespace": "keda"
          },
          "karpenter": {
            "enabled": true,
            "namespace": "karpenter"
          }
        }
      }
    }
  }
}
